# Copy this file to .env and fill the values for local development

# MongoDB connection string for local Mongo: mongodb://localhost:27017/khan_medical_center
MONGO_URI=mongodb://localhost:27017/khan_medical_center

# JWT secrets (use long random strings in production)
JWT_SECRET=change_me_for_development
REFRESH_TOKEN_SECRET=change_me_for_development

# Server port
PORT=5000

# SMTP (optional) - leave blank to use console fallback in development
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/khan-medical-center?appName=Cluster0
JWT_SECRET=replace_this_with_a_long_random_string
JWT_REFRESH_SECRET=replace_this_with_another_long_random_string
PORT=5000
CLIENT_URL=http://localhost:3000

# Optional SMTP settings for real email delivery. If omitted, emails are
# printed to the server console (development fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@khan-medical-center.local"
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/khan-medical-center
JWT_SECRET=replace_this_with_a_long_random_string
JWT_REFRESH_SECRET=replace_this_with_another_long_random_string
PORT=5000
